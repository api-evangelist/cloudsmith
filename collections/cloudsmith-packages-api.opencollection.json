      "items": [
        {
          "info": {
            "name": "Get a list of all packages associated with repository.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/packages/:owner/:repo/",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "A search term for querying names, filenames, versions, distributions, architectures, formats or statuses of packages."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "A field for sorting objects in ascending or descending order."
              }
            ]
          },
          "docs": "Get a list of all packages associated with repository."
        },
        {
          "info": {
            "name": "Return a list of Package Groups in a repository.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/packages/:owner/:repo/groups/",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "repo",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "group_by",
                "value": "",
                "type": "query",
                "description": "A field to group packages by. Available options: name, backend_kind."
              },
              {
                "name": "hide_subcomponents",
                "value": "",
                "type": "query",
                "description": "Whether to hide packages which are subcomponents of another package in the results"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "A search term for querying names, filenames, versions, distributions, architectures, formats, or statuses of packages."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "A field for sorting objects in ascending or descending order. Use `-` prefix for descending order (e.g., `-name`). Available options: name, count, num_downloads, size, last_push, backend_kind."
              }
            ]
          },
          "docs": "Return a list of Package Groups in a repository."
        },
