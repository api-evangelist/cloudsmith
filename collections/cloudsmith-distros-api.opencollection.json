          },
          "docs": "Get a list of all supported distributions."
        },
        {
          "info": {
            "name": "View for viewing/listing distributions.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/distros/:slug/",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "View for viewing/listing distributions."
        }
      ]
    }
  ],
  "bundled": true
}