{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudsmith API (v1) audit-log recycle-bin API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "recycle-bin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List soft-deleted packages in recycle bin",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/recycle-bin/:owner/",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "repository",
                "value": "",
                "type": "query",
                "description": "Filter packages by repository slug"
              }
            ]
          },
          "docs": "Retrieve all soft-deleted packages in the workspace. Optionally filter by repository using the 'repository' query parameter."
        },
        {
          "info": {
            "name": "recycle-bin_action",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/recycle-bin/:owner/action/",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Perform actions on soft-deleted packages in the recycle bin. Supported actions: permanently delete (hard delete), restore. Returns a list of successfully actioned packages and any packages that failed with error details. "
        }
      ]
    }
  ],
  "bundled": true
}